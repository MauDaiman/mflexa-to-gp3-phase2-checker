file_format_version 1.0;

timeset tset_func;
pattern func_throughput_parallel (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_func      00 XX 01;
                               tset_func      11 XX 01;
                               tset_func      00 XX 01;
                               tset_func      11 XX 01;
                               tset_func      00 XX 01;
                               tset_func      11 XX 01;
                               tset_func      00 XX 01;
set_loop (1)                   tset_func      11 XX 01;
Start_init:                    tset_func      00 XX 01;
                               tset_func      00 XX 01;
                               tset_func      00 XX 01;
end_loop(Start_init)           tset_func      00 XX 01;
                               tset_func      00 LL 01;
                               tset_func      11 HH 01;
                               tset_func      00 LL 01;
end_loop(Start1)               tset_func      11 HH 01;
halt                           tset_func      00 XX 01;
}

