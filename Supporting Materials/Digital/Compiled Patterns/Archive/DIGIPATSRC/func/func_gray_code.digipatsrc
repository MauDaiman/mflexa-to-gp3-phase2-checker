file_format_version 1.0;

timeset tset_func;
pattern func_gray_code (data_ins,data_outs,enables)
{
                               tset_func      00 XX 01;
                               tset_func      00 XX 01;
                               tset_func      00 XX 01;
                               tset_func      00 XX 01;
                               tset_func      00 XX 01;
                               tset_func      00 LL 01;
                               tset_func      01 LH 01;
                               tset_func      11 HH 01;
                               tset_func      10 HL 01;
                               tset_func      00 LL 01;
halt                           tset_func      00 XX 01;
}

