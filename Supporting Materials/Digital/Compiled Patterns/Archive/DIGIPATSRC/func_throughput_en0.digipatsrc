file_format_version 1.0;

timeset tset_func;
pattern func_throughput_en0 (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
set_loop (1)                   tset_func      1111 XXXX 00;
Start_init:                    tset_func      0000 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      0000 XXXX 00;
end_loop(Start_init)           tset_func      0000 XXXX 00;
                               tset_func      0000 LLLL 00;
                               tset_func      1000 HLLL 00;
                               tset_func      0000 LLLL 00;
end_loop(Start1)               tset_func      1000 HLLL 00;
                               tset_func      0000 LLLL 00;
                               tset_func      0100 LHLL 00;
                               tset_func      0000 LLLL 00;
end_loop(Start2)               tset_func      0100 LHLL 00;
                               tset_func      0000 LLLL 00;
                               tset_func      0010 LLHL 00;
                               tset_func      0000 LLLL 00;
end_loop(Start3)               tset_func      0010 LLHL 00;
                               tset_func      0000 LLLL 00;
                               tset_func      0001 LLLH 00;
                               tset_func      0000 LLLL 00;
end_loop(Start4)               tset_func      0001 LLLH 00;
halt                           tset_func      0000 XXXX 00;
}

