file_format_version 1.0;

timeset tset_PWL_10M;
pattern func_tPWL_10M (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_PWL_10M   11 XX 01;
                               tset_PWL_10M   00 LL 01;
                               tset_PWL_10M   11 HH 01;
end_loop(Start)                tset_PWL_10M   11 HH 01;
halt                           tset_PWL_10M   11 XX 01;
}

