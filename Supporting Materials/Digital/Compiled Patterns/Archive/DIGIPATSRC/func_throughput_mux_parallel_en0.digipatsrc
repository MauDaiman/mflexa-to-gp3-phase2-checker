file_format_version 1.0;

timeset tset_phase1, tset_phase2, tset_phase3, tset_phase4;
pattern func_throughput_mux_parallel_en0 (VIA_MUX,VIB_MUX,VIC_MUX,VID_MUX,DATA_OUTS,ENABLES)
{
set_loop (100)                 tset_phase1    11 11 11 11 XXXX 00;
Start1:                        tset_phase1    11 11 11 11 HHHH 00;
                               tset_phase3    11 11 11 11 HHHH 00;
                               tset_phase2    11 11 11 11 LLLL 00;
end_loop(Start1)               tset_phase4    11 11 11 11 LLLL 00;
                               tset_phase1    11 11 11 11 XXXX 00;
halt                           tset_phase1    11 11 11 11 XXXX 00;
}

