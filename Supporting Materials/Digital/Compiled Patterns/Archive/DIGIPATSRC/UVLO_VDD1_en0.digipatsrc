file_format_version 1.0;
export Positive_ramp, Negative_ramp;

timeset tset_func;


pattern UVLO_VDD1_en0 (DATA_INS,DATA_OUTS,ENABLES)
{
Positive_ramp:
                               tset_func      0000 XXXX 00;
                               tset_func      0000 XXXX 00;
repeat(512)                    tset_func      0000 HHHH 00;
halt                           tset_func      0000 XXXX 00;
Negative_ramp:
                               tset_func      0000 XXXX 00;
                               tset_func      0000 XXXX 00;
repeat(512)                    tset_func      0000 HHHH 00;
halt                           tset_func      0000 XXXX 00;
}


