file_format_version 1.0;

timeset tset_slow_speed_H;
pattern func_slow_speed_serial_high (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_slow_speed_H 11 XX 01;
                               tset_slow_speed_H 11 XX 01;
                               tset_slow_speed_H 11 XX 01;
end_loop(Start_init)           tset_slow_speed_H 11 XX 01;
set_loop (25)                  tset_slow_speed_H 11 HH 01;
Start1:                        tset_slow_speed_H 01 LH 01;
repeat(4)                      tset_slow_speed_H 01 LH 01;
repeat(5)                      tset_slow_speed_H 01 LH 01;
repeat(5)                      tset_slow_speed_H 01 LH 01;
repeat(4)                      tset_slow_speed_H 01 LH 01;
end_loop(Start1)               tset_slow_speed_H 01 LH 01;
                               tset_slow_speed_H 10 HL 01;
repeat(4)                      tset_slow_speed_H 10 HL 01;
repeat(5)                      tset_slow_speed_H 10 HL 01;
repeat(5)                      tset_slow_speed_H 10 HL 01;
repeat(4)                      tset_slow_speed_H 10 HL 01;
end_loop(Start2)               tset_slow_speed_H 10 HL 01;
halt                           tset_slow_speed_H 00 XX 01;
}

