file_format_version 1.0;

timeset tset_phase1_2, tset_phase3_4;
pattern func_throughput_mux_outs_parallel (VIA_MUX,VIB_MUX,VIC_MUX,VID_MUX,VOA_MUX,VOB_MUX,VOC_MUX,VOD_MUX,ENABLES)
{
set_loop (100)                 tset_phase1_2  11 11 11 11 XX XX XX XX 11;
Start1:                        tset_phase1_2  11 11 11 11 HL HL HL HL 11;
                               tset_phase3_4  11 11 11 11 HL HL HL HL 11;
end_loop(Start1)               tset_phase3_4  11 11 11 11 HL HL HL HL 11;
                               tset_phase1_2  11 11 11 11 XX XX XX XX 11;
halt                           tset_phase1_2  11 11 11 11 XX XX XX XX 11;
}

