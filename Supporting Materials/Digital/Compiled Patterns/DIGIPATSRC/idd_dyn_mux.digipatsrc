file_format_version 1.0;

timeset tset_phase1, tset_phase2, tset_phase3, tset_phase4;
pattern idd_dyn_mux (VIA_mux,VIB_mux,data_outs)
{
Start:
                               tset_phase1    11 11 XX;
                               tset_phase2    11 11 XX;
                               tset_phase3    11 11 XX;
                               tset_phase4    11 11 XX;
set_seqflag(seqflag0)          tset_phase1    11 11 HH;
                               tset_phase2    11 11 LL;
                               tset_phase3    11 11 HH;
                               tset_phase4    11 11 LL;
test:
jump_if(seqflag0, test )       tset_phase1    11 11 HH;
                               tset_phase2    11 11 LL;
                               tset_phase3    11 11 HH;
                               tset_phase4    11 11 LL;
halt                           tset_phase1    11 11 XX;
}

