file_format_version 1.0;

timeset tset_func;
pattern func_throughput_serial (data_ins,data_outs)
{
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
set_loop (1)                   tset_func      11 XX;
Start_init:                    tset_func      00 XX;
                               tset_func      00 XX;
                               tset_func      00 XX;
end_loop(Start_init)           tset_func      00 XX;
Start1:                        tset_func      00 LL;
                               tset_func      10 HL;
                               tset_func      00 LL;
end_loop(Start1)               tset_func      10 HL;
Start2:                        tset_func      00 LL;
                               tset_func      01 LH;
                               tset_func      00 LL;
end_loop(Start2)               tset_func      01 LH;
Start5:                        tset_func      01 LH;
                               tset_func      11 HH;
                               tset_func      01 LH;
end_loop(Start5)               tset_func      11 HH;
Start6:                        tset_func      10 HL;
                               tset_func      11 HH;
                               tset_func      10 HL;
end_loop(Start6)               tset_func      11 HH;
halt                           tset_func      00 XX;
}

