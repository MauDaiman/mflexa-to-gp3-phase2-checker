file_format_version 1.0;

timeset tset_0;
pattern idd_dyn (data_ins,data_outs)
{
Start:
                               tset_0         00 XX;
                               tset_0         11 HH;
                               tset_0         11 HH;
set_seqflag(seqflag0)          tset_0         11 HH;
test:
jump_if(seqflag0, test )       tset_0         11 HH;
                               tset_0         11 HH;
halt                           tset_0         11 HH;
}

