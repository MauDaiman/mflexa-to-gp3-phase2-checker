file_format_version 1.0;

timeset tset_slow_speed_H;
pattern func_slow_speed_serial_high (data_ins,data_outs)
{
Start_init:                    tset_slow_speed_H 11 XX;
                               tset_slow_speed_H 11 XX;
                               tset_slow_speed_H 11 XX;
end_loop(Start_init)           tset_slow_speed_H 11 XX;
set_loop (25)                  tset_slow_speed_H 11 HH;
Start1:                        tset_slow_speed_H 01 LH;
repeat(4)                      tset_slow_speed_H 01 LH;
repeat(5)                      tset_slow_speed_H 01 LH;
repeat(5)                      tset_slow_speed_H 01 LH;
repeat(4)                      tset_slow_speed_H 01 LH;
end_loop(Start1)               tset_slow_speed_H 01 LH;
Start2:                        tset_slow_speed_H 10 HL;
repeat(4)                      tset_slow_speed_H 10 HL;
repeat(5)                      tset_slow_speed_H 10 HL;
repeat(5)                      tset_slow_speed_H 10 HL;
repeat(4)                      tset_slow_speed_H 10 HL;
end_loop(Start2)               tset_slow_speed_H 10 HL;
halt                           tset_slow_speed_H 00 XX;
}

