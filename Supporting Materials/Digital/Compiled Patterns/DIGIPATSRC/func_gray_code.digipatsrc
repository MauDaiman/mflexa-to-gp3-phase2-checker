file_format_version 1.0;

timeset tset_func;
pattern func_gray_code (data_ins,data_outs)
{
                               tset_func      00 XX;
                               tset_func      00 XX;
                               tset_func      00 XX;
                               tset_func      00 XX;
                               tset_func      00 XX;
                               tset_func      00 LL;
                               tset_func      01 LH;
                               tset_func      11 HH;
                               tset_func      10 HL;
                               tset_func      00 LL;
halt                           tset_func      00 XX;
}

