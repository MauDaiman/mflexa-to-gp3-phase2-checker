file_format_version 1.0;

timeset tset_func;
pattern vil_vih_search (data_ins,data_outs)
{
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
                               tset_func      11 XX;
                               tset_func      00 XX;
set_loop (10)                  tset_func      11 XX;
Start:                         tset_func      00 LL;
                               tset_func      11 HH;
                               tset_func      00 LL;
end_loop(Start)                tset_func      11 HH;
halt                           tset_func      00 XX;
}

