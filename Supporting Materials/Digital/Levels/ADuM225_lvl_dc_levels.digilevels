<?xml version="1.0" encoding="utf-8"?>
<PinLevelsFile xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xmlns="http://www.ni.com/Semiconductor/PinLevels">
  <PinLevelsSheet>
    <DigitalPinLevelSets>
      <DigitalPinLevelSet pin="VIA_mux">
        <Vil>_._VDD1_vil</Vil>
        <Vih>_._VDD1_vih</Vih>
        <Vol>_._VDD1_vol</Vol>
        <Voh>_._VDD1_voh</Voh>
        <Iol>_._VDD1_iol_20</Iol>
        <Ioh>_._VDD1_ioh_20</Ioh>
        <Vterm>_._VDD1_vt</Vterm>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
      <DigitalPinLevelSet pin="VIB_mux">
        <Vil>_._VDD1_vil</Vil>
        <Vih>_._VDD1_vih</Vih>
        <Vol>_._VDD1_vol</Vol>
        <Voh>_._VDD1_voh</Voh>
        <Iol>_._VDD1_iol_20</Iol>
        <Ioh>_._VDD1_ioh_20</Ioh>
        <Vterm>_._VDD1_vt</Vterm>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
      <DigitalPinLevelSet pin="VOA_mux">
        <Vil>_._VDD2_vil</Vil>
        <Vih>_._VDD2_vih</Vih>
        <Vol>_._VDD2_vol</Vol>
        <Voh>_._VDD2_voh</Voh>
        <Iol>_._VDD2_iol_4000</Iol>
        <Ioh>_._VDD2_ioh_4000</Ioh>
        <Vterm>_._VDD2_vt</Vterm>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
      <DigitalPinLevelSet pin="VOB_mux">
        <Vil>_._VDD2_vil</Vil>
        <Vih>_._VDD2_vih</Vih>
        <Vol>_._VDD2_vol</Vol>
        <Voh>_._VDD2_voh</Voh>
        <Iol>_._VDD2_iol_4000</Iol>
        <Ioh>_._VDD2_ioh_4000</Ioh>
        <Vterm>_._VDD2_vt</Vterm>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
    </DigitalPinLevelSets>
    <PowerPinLevelSets>
      <PowerPinLevelSet pin="vdd">
        <Vf>5</Vf>
        <If>10 mA</If>
      </PowerPinLevelSet>
    </PowerPinLevelSets>
  </PinLevelsSheet>
</PinLevelsFile>