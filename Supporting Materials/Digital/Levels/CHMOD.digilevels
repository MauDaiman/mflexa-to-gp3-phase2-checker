<?xml version="1.0" encoding="utf-8"?>
<PinLevelsFile xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xmlns="http://www.ni.com/Semiconductor/PinLevels">
  <PinLevelsSheet>
    <DigitalPinLevelSets>
      <DigitalPinLevelSet pin="CHMOD_CS">
        <Vil>0</Vil>
        <Vih>5</Vih>
        <Vol>2</Vol>
        <Voh>2</Voh>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
      <DigitalPinLevelSet pin="CHMOD_DIN">
        <Vil>0</Vil>
        <Vih>5</Vih>
        <Vol>2</Vol>
        <Voh>2</Voh>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
      <DigitalPinLevelSet pin="CHMOD_RESET">
        <Vil>0</Vil>
        <Vih>5</Vih>
        <Vol>2</Vol>
        <Voh>2</Voh>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
      <DigitalPinLevelSet pin="CHMOD_SCLK">
        <Vil>0</Vil>
        <Vih>5</Vih>
        <Vol>2</Vol>
        <Voh>2</Voh>
        <TerminationMode>HighZ</TerminationMode>
      </DigitalPinLevelSet>
    </DigitalPinLevelSets>
  </PinLevelsSheet>
</PinLevelsFile>