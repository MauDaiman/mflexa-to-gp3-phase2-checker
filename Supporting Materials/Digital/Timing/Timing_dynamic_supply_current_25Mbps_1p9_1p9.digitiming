<?xml version="1.0" encoding="utf-8"?>
<TimingFile xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xmlns="http://www.ni.com/Semiconductor/Timing">
  <TimingSheet>
    <TimeSets>
      <TimeSet name="tset_0">
        <Period>8E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <ReturnToLow>
              <On>0</On>
              <Data>(8E-08)/4</Data>
              <Return>(8E-08)*(3/4)</Return>
              <Off>8E-08</Off>
            </ReturnToLow>
            <CompareStrobe>
              <Strobe>8E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>8E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>(8E-08)/2</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
      <TimeSet name="tset_func">
        <Period>4E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
      <TimeSet name="tset_PWL_10M">
        <Period>4E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <ReturnToHigh>
              <On>0</On>
              <Data>1E-08</Data>
              <Return>2E-08</Return>
              <Off>4E-08</Off>
            </ReturnToHigh>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>3E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
      <TimeSet name="tset_PWH_10M">
        <Period>4E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <ReturnToLow>
              <On>0</On>
              <Data>1E-08</Data>
              <Return>2E-08</Return>
              <Off>4E-08</Off>
            </ReturnToLow>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>3E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
      <TimeSet name="tset_find_edge">
        <Period>4E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>4E-09</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
      <TimeSet name="tset_sweep">
        <Period>4E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <ReturnToLow>
              <On>0</On>
              <Data>2.025E-08</Data>
              <Return>2.4E-08</Return>
              <Off>4E-08</Off>
            </ReturnToLow>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
      <TimeSet name="tset_slow_speed_H">
        <Period>4E-08</Period>
        <PinEdges>
          <PinEdge pin="data_ins">
            <ReturnToHigh>
              <On>0</On>
              <Data>0</Data>
              <Return>2E-08</Return>
              <Off>4E-08</Off>
            </ReturnToHigh>
            <CompareStrobe>
              <Strobe>4E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="data_outs">
            <DriveNonReturn>
              <On>0</On>
              <Data>0</Data>
              <Off>4E-08</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>1.2E-08</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
        </PinEdges>
      </TimeSet>
    </TimeSets>
  </TimingSheet>
</TimingFile>