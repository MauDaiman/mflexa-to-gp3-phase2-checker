    <Bin name="PAT" number="151" hardwareBin="7" />
    <Bin name="PATEF" number="152" hardwareBin="7" />
    <Bin name="SPAT" number="153" hardwareBin="7" />
    <Bin name="ERROR" number="99" hardwareBin="8" />
