<?xml version="1.0" encoding="utf-8"?>
<TimingFile xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xmlns="http://www.ni.com/Semiconductor/Timing">
  <TimingSheet>
    <TimeSets>
      <TimeSet name="tset1">
        <Period>1 µs</Period>
        <PinEdges>
          <PinEdge pin="HMOD_SCLK">
            <ReturnToLow>
              <On>0 ns</On>
              <Data>500 ns</Data>
              <Return>1 µs</Return>
              <Off>1 µs</Off>
            </ReturnToLow>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="HMOD_DIN">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>350 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="HMOD_RESET">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>0 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
          </PinEdge>
          <PinEdge pin="HMOD_CS_1_4">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>250 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
            <Comment>HMOD 1 to 4</Comment>
          </PinEdge>
          <PinEdge pin="HMOD_CS_5_10">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>250 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
            <Comment>HMOD 5 to 10</Comment>
          </PinEdge>
          <PinEdge pin="HMOD_CS_11_13_24_25">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>250 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
            <Comment>HMOD 11 to 13 and 24 to 25</Comment>
          </PinEdge>
          <PinEdge pin="HMOD_CS_14_18">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>250 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
            <Comment>HMOD 14 to 18</Comment>
          </PinEdge>
          <PinEdge pin="HMOD_CS_19_23">
            <DriveNonReturn>
              <On>0 ns</On>
              <Data>250 ns</Data>
              <Off>1 µs</Off>
            </DriveNonReturn>
            <CompareStrobe>
              <Strobe>0</Strobe>
            </CompareStrobe>
            <DataSource>Pattern</DataSource>
            <Comment>HMOD 19 to 23</Comment>
          </PinEdge>
        </PinEdges>
      </TimeSet>
    </TimeSets>
  </TimingSheet>
</TimingFile>