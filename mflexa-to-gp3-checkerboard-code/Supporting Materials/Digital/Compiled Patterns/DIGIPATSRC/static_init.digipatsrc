file_format_version 1.0;
export inputs_lo, inputs_hi;

timeset tset_func;
pattern static_init (data_ins,data_outs)
{
inputs_lo:
                               tset_func      00 XX;
halt                           tset_func      00 XX;
inputs_hi:
                               tset_func      11 XX;
halt                           tset_func      11 XX;
}


