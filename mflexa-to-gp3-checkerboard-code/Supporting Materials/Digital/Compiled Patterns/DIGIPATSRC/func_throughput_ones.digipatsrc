file_format_version 1.0;

timeset tset_func;
pattern func_throughput_ones (data_ins,data_outs)
{
                               tset_func      11 XX;
                               tset_func      11 XX;
                               tset_func      11 XX;
                               tset_func      11 XX;
                               tset_func      11 XX;
                               tset_func      11 XX;
                               tset_func      11 XX;
set_loop (1)                   tset_func      11 XX;
Start_init:                    tset_func      11 XX;
                               tset_func      11 XX;
                               tset_func      11 XX;
end_loop(Start_init)           tset_func      11 XX;
Start1:                        tset_func      11 HH;
                               tset_func      11 HH;
                               tset_func      11 HH;
end_loop(Start1)               tset_func      11 HH;
halt                           tset_func      11 XX;
}

