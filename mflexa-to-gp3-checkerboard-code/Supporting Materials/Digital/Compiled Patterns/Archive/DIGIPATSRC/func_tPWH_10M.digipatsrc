file_format_version 1.0;

timeset tset_PWH_10M;
pattern func_tPWH_10M (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_PWH_10M   00 XX 01;
                               tset_PWH_10M   11 HH 01;
                               tset_PWH_10M   00 LL 01;
end_loop(Start)                tset_PWH_10M   00 LL 01;
halt                           tset_PWH_10M   00 XX 01;
}

