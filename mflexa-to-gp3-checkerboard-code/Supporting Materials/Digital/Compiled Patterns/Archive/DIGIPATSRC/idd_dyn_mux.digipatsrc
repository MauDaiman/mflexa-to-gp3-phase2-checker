file_format_version 1.0;

timeset tset_phase1, tset_phase2, tset_phase3, tset_phase4;
pattern idd_dyn_mux (VIA_MUX,VIB_MUX,DATA_OUTS,ENABLES)
{
Start:
                               tset_phase1    11 11 XX 01;
                               tset_phase2    11 11 XX 01;
                               tset_phase3    11 11 XX 01;
                               tset_phase4    11 11 XX 01;
set_seqflag(seqflag0)          tset_phase1    11 11 HH 01;
                               tset_phase2    11 11 LL 01;
                               tset_phase3    11 11 HH 01;
                               tset_phase4    11 11 LL 01;
test:
jump_if(seqflag0, test )       tset_phase1    11 11 HH 01;
                               tset_phase2    11 11 LL 01;
                               tset_phase3    11 11 HH 01;
                               tset_phase4    11 11 LL 01;
halt                           tset_phase1    11 11 XX 01;
}

