file_format_version 1.0;

timeset tset_0;
pattern idd_dyn (data_ins,data_outs,enables)
{
Start:
                               tset_0         00 XX 01;
                               tset_0         11 HH 01;
                               tset_0         11 HH 01;
set_seqflag(seqflag0)          tset_0         11 HH 01;
test:
jump_if(seqflag0, test )       tset_0         11 HH 01;
                               tset_0         11 HH 01;
halt                           tset_0         11 HH 01;
}

