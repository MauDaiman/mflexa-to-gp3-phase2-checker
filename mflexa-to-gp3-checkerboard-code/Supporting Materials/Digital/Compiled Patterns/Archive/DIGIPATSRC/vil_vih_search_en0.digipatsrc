file_format_version 1.0;

timeset tset_func;
pattern vil_vih_search_en0 (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      0000 XXXX 00;
set_loop (10)                  tset_func      1111 XXXX 00;
Start:                         tset_func      0000 LLLL 00;
                               tset_func      1111 HHHH 00;
                               tset_func      0000 LLLL 00;
end_loop(Start)                tset_func      1111 HHHH 00;
halt                           tset_func      0000 XXXX 00;
}

