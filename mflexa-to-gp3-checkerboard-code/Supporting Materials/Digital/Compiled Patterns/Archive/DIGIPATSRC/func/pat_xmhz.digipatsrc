file_format_version 1.0;

timeset tset_func;
pattern pat_xmhz (data_ins,data_outs, enables)
{
                               tset_func      00 XX 11;
                               tset_func      11 XX 11;
                               tset_func      00 LL 11;
                               tset_func      11 HH 11;
                               tset_func      00 LL 11;
                               tset_func      11 HH 11;
                               tset_func      00 LL 11;
                               tset_func      11 HH 11;
                               tset_func      00 XX 11;
halt                           tset_func      11 XX 11;
}

