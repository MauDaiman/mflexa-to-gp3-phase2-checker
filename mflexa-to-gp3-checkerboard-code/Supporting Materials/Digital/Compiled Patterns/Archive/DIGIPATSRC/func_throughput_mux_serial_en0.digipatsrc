file_format_version 1.0;

timeset tset_phase1, tset_phase2, tset_phase3, tset_phase4;
pattern func_throughput_mux_serial_en0 (VIA_MUX,VIB_MUX,VIC_MUX,VID_MUX,DATA_OUTS,ENABLES)
{
                               tset_phase1    11 11 11 11 XXXX 00;
set_loop (100)                 tset_phase1    11 00 00 00 XXXX 00;
Start1:                        tset_phase1    11 00 00 00 HLLL 00;
                               tset_phase3    11 00 00 00 HLLL 00;
                               tset_phase4    11 00 00 00 LLLL 00;
end_loop(Start1)               tset_phase2    11 00 00 00 LLLL 00;
set_loop (100)                 tset_phase2    00 11 00 00 XXXX 00;
Start1:                        tset_phase1    00 11 00 00 LHLL 00;
                               tset_phase3    00 11 00 00 LHLL 00;
                               tset_phase4    00 11 00 00 LLLL 00;
end_loop(Start2)               tset_phase2    00 11 00 00 LLLL 00;
set_loop (100)                 tset_phase2    00 00 11 00 XXXX 00;
Start1:                        tset_phase1    00 00 11 00 LLHL 00;
                               tset_phase3    00 00 11 00 LLHL 00;
                               tset_phase4    00 00 11 00 LLLL 00;
end_loop(Start3)               tset_phase2    00 00 11 00 LLLL 00;
set_loop (100)                 tset_phase2    00 00 00 11 XXXX 00;
Start1:                        tset_phase1    00 00 00 11 LLLH 00;
                               tset_phase3    00 00 00 11 LLLH 00;
                               tset_phase4    00 00 00 11 LLLL 00;
end_loop(Start4)               tset_phase2    00 00 00 11 LLLL 00;
                               tset_phase1    11 11 11 11 XXXX 00;
halt                           tset_phase1    11 11 11 11 XXXX 00;
}

