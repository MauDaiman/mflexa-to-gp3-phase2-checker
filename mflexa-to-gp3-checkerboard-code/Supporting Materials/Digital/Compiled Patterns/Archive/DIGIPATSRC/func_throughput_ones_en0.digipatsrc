file_format_version 1.0;

timeset tset_func;
pattern func_throughput_ones_en0 (DATA_INS,DATA_OUTS,ENABLES)
{
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
set_loop (1)                   tset_func      1111 XXXX 00;
Start_init:                    tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
                               tset_func      1111 XXXX 00;
end_loop(Start_init)           tset_func      1111 XXXX 00;
                               tset_func      1111 HHHH 00;
                               tset_func      1111 HHHH 00;
                               tset_func      1111 HHHH 00;
end_loop(Start1)               tset_func      1111 HHHH 00;
halt                           tset_func      1111 XXXX 00;
}

