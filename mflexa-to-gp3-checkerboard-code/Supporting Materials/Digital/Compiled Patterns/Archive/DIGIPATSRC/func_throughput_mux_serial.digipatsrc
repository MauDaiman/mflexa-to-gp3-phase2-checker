file_format_version 1.0;

timeset tset_phase1, tset_phase2, tset_phase3, tset_phase4;
pattern func_throughput_mux_serial (VIA_MUX,VIB_MUX,DATA_OUTS,ENABLES)
{
set_loop (100)                 tset_phase1    11 00 XX 01;
Start1:                        tset_phase1    11 00 HL 01;
                               tset_phase3    11 00 HL 01;
                               tset_phase2    11 00 LL 01;
end_loop(Start1)               tset_phase4    11 00 LL 01;
set_loop (100)                 tset_phase4    00 11 XX 01;
Start1:                        tset_phase1    00 11 LH 01;
                               tset_phase3    00 11 LH 01;
                               tset_phase2    00 11 LL 01;
end_loop(Start2)               tset_phase4    00 11 LL 01;
                               tset_phase4    00 00 XX 01;
halt                           tset_phase1    11 11 XX 01;
}

